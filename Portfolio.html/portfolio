<style>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', sans-serif; background: #050505; color: #e5e5e5; overflow-x: hidden; }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #050505; }
  ::-webkit-scrollbar-thumb { background: #3b82f6; border-radius: 3px; }

  /* ── ANGLE SLIDE SECTIONS ── */
  .angled-section {
    transform: skewY(-3deg);
  }
  .angled-section > * {
    transform: skewY(3deg);
  }

  /* ── MARQUEE BANNERS ── */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
  }
  .marquee-track.reverse {
    animation: marquee-scroll-reverse 35s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    0% { transform: translateX(0) rotate(-2deg); }
    100% { transform: translateX(-50%) rotate(-2deg); }
  }
  @keyframes marquee-scroll-reverse {
    0% { transform: translateX(-50%) rotate(2deg); }
    100% { transform: translateX(0) rotate(2deg); }
  }

  /* ── FUN HOVER BUTTONS ── */
  .btn-slide {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    font-weight: 600;
    font-size: 14px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    overflow: hidden;
    border: none;
    text-decoration: none;
  }
  .btn-slide.primary {
    background: linear-gradient(to right, #1d4ed8, #2563eb);
    color: #fff;
    box-shadow: 0 0 30px rgba(29,78,216,0.4);
  }
  .btn-slide.primary:hover {
    transform: translateX(10px) translateY(-3px) rotate(-1deg);
    box-shadow: 0 0 50px rgba(29,78,216,0.6), 0 10px 30px rgba(29,78,216,0.3);
  }
  .btn-slide.outline {
    background: transparent;
    color: #e5e5e5;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .btn-slide.outline:hover {
    transform: translateX(-10px) translateY(-3px) rotate(1deg);
    border-color: #3b82f6;
    color: #60a5fa;
    box-shadow: 0 0 30px rgba(59,130,246,0.2);
  }
  .btn-slide.fun {
    background: linear-gradient(135deg, #7c3aed, #3b82f6);
    color: #fff;
    box-shadow: 0 0 20px rgba(124,58,237,0.3);
  }
  .btn-slide.fun:hover {
    transform: translateY(-6px) scale(1.05) rotate(2deg);
    box-shadow: 0 0 50px rgba(124,58,237,0.5), 0 15px 30px rgba(0,0,0,0.4);
  }
  .btn-slide .arrow {
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .btn-slide:hover .arrow {
    transform: translateX(6px);
  }

  /* ── FLOATING BADGE ── */
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-14px) rotate(3deg); }
  }
  .float-badge {
    animation: float 4s ease-in-out infinite;
  }
  .float-badge:nth-child(2) { animation-delay: 0.5s; }
  .float-badge:nth-child(3) { animation-delay: 1s; }
  .float-badge:nth-child(4) { animation-delay: 1.5s; }

  /* ── WOBBLE ── */
  @keyframes wobble {
    0%, 100% { transform: rotate(-1deg); }
    50% { transform: rotate(1deg); }
  }
  .wobble { animation: wobble 3s ease-in-out infinite; }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .reveal.from-left {
    transform: translateX(-80px) rotate(-2deg);
  }
  .reveal.from-right {
    transform: translateX(80px) rotate(2deg);
  }
  .reveal.from-bottom {
    transform: translateY(60px) rotate(-1deg);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateX(0) translateY(0) rotate(0deg);
  }

  /* ── PULSE RING ── */
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2.5); opacity: 0; }
  }
  .pulse-ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #3b82f6;
    animation: pulse-ring 2s ease-out infinite;
  }

  /* ── EXPERIENCE CARD ── */
  .exp-card {
    background: rgba(23,23,23,0.5);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 24px;
    padding: 32px;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
  }
  .exp-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(59,130,246,0.08), transparent);
    opacity: 0;
    transition: opacity 0.5s;
  }
  .exp-card:hover {
    transform: translateY(-8px) rotate(-0.5deg);
    border-color: rgba(59,130,246,0.3);
    box-shadow: 0 0 60px rgba(59,130,246,0.12);
  }
  .exp-card:hover::before { opacity: 1; }

  /* ── SKILL PILL ── */
  .skill-pill {
    display: inline-block;
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    background: rgba(59,130,246,0.08);
    border: 1px solid rgba(59,130,246,0.15);
    color: #93c5fd;
    transition: all 0.3s cubic-bezier(0.23,1,0.32,1);
    cursor: default;
  }
  .skill-pill:hover {
    background: rgba(59,130,246,0.2);
    transform: translateY(-4px) rotate(-2deg) scale(1.08);
    box-shadow: 0 6px 20px rgba(59,130,246,0.2);
  }

  /* ── CERT CARD ── */
  .cert-card {
    background: rgba(23,23,23,0.4);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 24px;
    transition: all 0.4s cubic-bezier(0.23,1,0.32,1);
  }
  .cert-card:hover {
    transform: translateX(8px) rotate(1deg);
    border-color: rgba(59,130,246,0.25);
    box-shadow: 0 0 30px rgba(59,130,246,0.08);
  }

  /* ── HERO PARTICLE ── */
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.3; }
    25% { transform: translate(30px, -40px) rotate(90deg); opacity: 0.6; }
    50% { transform: translate(-20px, -80px) rotate(180deg); opacity: 0.3; }
    75% { transform: translate(40px, -30px) rotate(270deg); opacity: 0.5; }
  }
  .particle {
    position: absolute;
    width: 4px; height: 4px;
    background: #3b82f6;
    border-radius: 50%;
    animation: drift 6s ease-in-out infinite;
  }

  /* ── NAV ── */
  nav a {
    position: relative;
    transition: color 0.3s;
  }
  nav a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 2px;
    background: #3b82f6;
    transition: width 0.3s;
    border-radius: 1px;
  }
  nav a:hover { color: #60a5fa; }
  nav a:hover::after { width: 100%; }

  /* ── DIAGONAL DIVIDER ── */
  .diagonal-divider {
    position: relative;
  }
  .diagonal-divider::after {
    content: '';
    position: absolute;
    bottom: -40px; left: 0;
    width: 100%; height: 80px;
    background: inherit;
    transform: skewY(-3deg);
    z-index: 1;
  }

  /* ── TOAST ── */
  .toast {
    position: fixed;
    bottom: 30px; right: 30px;
    background: #1d4ed8;
    color: #fff;
    padding: 16px 28px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 500;
    z-index: 9999;
    transform: translateX(120%) rotate(5deg);
    transition: all 0.5s cubic-bezier(0.23,1,0.32,1);
    box-shadow: 0 10px 30px rgba(29,78,216,0.4);
  }
  .toast.show {
    transform: translateX(0) rotate(0deg);
  }

  /* ── ANGLE SECTION REVEAL ── */
  .angle-reveal {
    opacity: 0;
    transform: translateX(-100px) skewY(-3deg);
    transition: all 1s cubic-bezier(0.23,1,0.32,1);
  }
  .angle-reveal.from-right-side {
    transform: translateX(100px) skewY(3deg);
  }
  .angle-reveal.visible {
    opacity: 1;
    transform: translateX(0) skewY(0deg);
  }

  /* ── STAT COUNTER ── */
  .stat-box {
    text-align: center;
    padding: 32px;
    background: rgba(23,23,23,0.4);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 24px;
